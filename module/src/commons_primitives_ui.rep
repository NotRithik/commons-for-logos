class CommonsPrimitivesUi
{
    SLOT(QString configure(QString cliPath, QString walletDir))
    SLOT(QString selectAllowlistWitness(QString witnessPath))
    SLOT(QString selectThresholdWitness(QString witnessPath))
    SLOT(QString createDistribution(QString stateAccount, QString rootHex, int memberCount))
    SLOT(QString claimAllowlist(QString stateAccount))
    SLOT(QString inspectDistribution(QString stateAccount))
    SLOT(QString createGroup(QString stateAccount, QString rootHex, int memberCount, int threshold, QString initialValue))
    SLOT(QString proposeParameter(QString stateAccount, QString nextValue))
    SLOT(QString approveParameter(QString stateAccount))
    SLOT(QString executeParameter(QString stateAccount))
    SLOT(QString inspectGroup(QString stateAccount))
    SLOT(QString schemaJson())
    PROP(QString captureDirectory="" READONLY)
    PROP(QString backendState="Offline" READONLY)
    PROP(QString statusText="Connect a client and a testnet wallet to begin." READONLY)
    PROP(bool configured=false READONLY)
    PROP(bool busy=false READONLY)
    PROP(QString activeOperation="" READONLY)
    PROP(QString lastOperation="" READONLY)
    PROP(QString lastResultJson="{}" READONLY)
    PROP(QString lastError="" READONLY)
    PROP(QString allowlistWitnessLabel="No witness selected" READONLY)
    PROP(QString thresholdWitnessLabel="No witness selected" READONLY)
    PROP(QString distributionStateAccount="" READONLY)
    PROP(QString groupStateAccount="" READONLY)
    PROP(QString distributionSummary="No live distribution state loaded." READONLY)
    PROP(QString groupSummary="No live group state loaded." READONLY)
    SIGNAL(operationFinished(QString operation, QString resultJson))
    SIGNAL(operationFailed(QString operation, QString errorMessage))
}
